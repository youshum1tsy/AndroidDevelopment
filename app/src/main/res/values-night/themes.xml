<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Night mode). -->
    <style name="Theme.AndroidDevelopment" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Основной цвет в тёмной теме (кнопки) -->
        <item name="colorPrimary">@color/muted_teal</item>
        <item name="colorPrimaryVariant">@color/jungle_teal</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Акцентный цвет (RadioButton, Switch) -->
        <item name="colorSecondary">@color/frozen_water</item>
        <item name="colorSecondaryVariant">@color/muted_teal</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Цвет статус-бара -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>